# AI
MODEL_PROVIDER=gemini            # gemini (hosted API) | ollama (local / offline) | mock
GEMINI_API_KEY=                  # server-only
CLOUD_MODEL=                     # exact model id from the Gemini API (see README)
MODEL_THINKING=minimal           # minimal (fast) | default (model thinks; ~20s+ slower)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# Supabase (all optional — app must work without them)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server-only, NEVER imported in client code

NEXT_PUBLIC_APP_NAME=INKPLAY
NEXT_PUBLIC_INTRO_VIDEO=0
